{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fuckbigtech-ai/homestead-memory",
  "title": "Homestead Memory",
  "description": "Tamper-evident record of what your AI agent did, plus local-first verifiable memory.",
  "version": "0.4.0",
  "repository": {
    "url": "https://github.com/fuckbigtech-ai/homestead-memory",
    "source": "github"
  },
  "websiteUrl": "https://fuckbigtech.ai/lab/",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "homestead-memory",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "isRequired": true,
          "description": "run the MCP server on stdio"
        }
      ],
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "homestead-memory",
          "isRequired": true,
          "description": "the console script is 'hsm', not the package name, so uvx needs --from"
        },
        {
          "type": "positional",
          "value": "hsm",
          "isRequired": true,
          "description": "the installed console script"
        }
      ]
    }
  ]
}
